# ---------------------------------------------------------------------------
# CodeDoc Context Isolator — environment configuration
#
# Copy this file to `.env` and fill in the values:
#     cp .env.example .env
#
# `.env` is gitignored (see .gitignore); only this template is committed, so a
# real key can never be pushed by accident.
# ---------------------------------------------------------------------------

# REQUIRED. Your Google Gemini API key.
#
# Every benchmark call is proxied through the Express server so this key stays
# server-side and never reaches the browser bundle. The server now refuses to
# start without it, rather than starting "healthy" and failing one request at a
# time — a misconfigured deployment should be obvious in the logs immediately.
#
# Get a key at: https://aistudio.google.com/apikey
# In AI Studio, this is injected automatically from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPTIONAL. Port to listen on. Defaults to 3000.
# Cloud Run and most PaaS providers inject this automatically — leave it unset
# in those environments so the platform's value is used.
# PORT=3000

# OPTIONAL. Set to "production" to serve the pre-built assets from `dist/`
# instead of running Vite's dev middleware. `npm start` expects this.
# NODE_ENV=production

# OPTIONAL. Override the USD-to-INR rate used by the cost estimator.
# Defaults to 87.0. This is an approximation for display only — it is not
# fetched from any live FX feed, and every figure derived from it is labelled
# as an estimate in the UI.
# VITE_USD_TO_INR=87.0
